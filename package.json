{
  "name": "viapeninsula",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "check": "tsc && tsc -p src/fetcher",
    "daily": "node --env-file-if-exists=.env.local src/build/daily.ts",
    "deploy": "npm run check && vite build && wrangler deploy && wrangler deploy -c src/fetcher/wrangler.jsonc",
    "cors": "wrangler r2 bucket cors set viapeninsula-live --file r2-cors.json --force",
    "record": "node src/record.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.1",
    "pbf": "^5.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
