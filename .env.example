# Copy to .env.local and fill in. Never commit it.

# developer.tmb.cat
TMB_APP_ID=
TMB_APP_KEY=

# opendata.tram.cat (credentials arrive by email)
TRAM_CLIENT_ID=
TRAM_CLIENT_SECRET=

# dadesobertes.fgc.cat account API key (optional: own quota instead of 5,000/day per IP)
FGC_API_KEY=

# Fine-grained token: Actions write, gariasf/viapeninsula only
GITHUB_DISPATCH_TOKEN=

# Cloudflare API token with Workers R2 Storage: Edit, for the daily build in GitHub Actions (set there
# as CLOUDFLARE_API_TOKEN). Don't use that name here: Wrangler reads it from this file and would use
# the token instead of your login, so deploys and `wrangler secret put` fail.
R2_API_TOKEN=
