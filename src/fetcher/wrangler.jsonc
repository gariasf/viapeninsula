{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The fetcher runs in a Worker of its own, without routes, so viewers never reach its code (ADR-0003).
  "name": "viapeninsula-fetcher",
  "main": "worker.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "FETCHER", "class_name": "Fetcher" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Fetcher"] }],
  "r2_buckets": [
    { "binding": "LIVE", "bucket_name": "viapeninsula-live" },
    // Each 5 minutes' snapshots, for the Delay history: a bucket of their own, with no public or custom domain, given
    // TRAM's terms, whose lifecycle rule deletes them 7 days after they're put. It must exist before a deploy (#806).
    { "binding": "HISTORY", "bucket_name": "viapeninsula-history" }
  ],
  // Every minute, which starts the fetcher's runs after a deploy and restarts them if they ever stop,
  // and at 00:30 UTC, after midnight in Madrid all year, which starts the daily build (worker.ts's DAILY).
  "triggers": { "crons": ["* * * * *", "30 0 * * *"] },
  // A run takes about 12 ms of CPU, so a bug can't cost more than a second of it each run.
  "limits": { "cpu_ms": 1000 },
  // Workers Logs keeps each run's logs for 7 days, such as the Networks missing from a feed that works (#248).
  "observability": { "enabled": true }
}
